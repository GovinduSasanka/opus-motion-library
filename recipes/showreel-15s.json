{
  "id": "showreel-15s",
  "title": "Motion showreel (15 s)",
  "useFor": "A punchy 15-second showreel / portfolio opener / 'what we can make' sizzle: a hook word, five hard cuts of contrasting motions on a 120 BPM grid, then a logo lock-up. Dark tech-minimal.",
  "format": "landscape",
  "background": "#0A0A0B",
  "tags": [
    "showreel",
    "reel",
    "portfolio",
    "sizzle",
    "motion design",
    "beat",
    "cuts",
    "montage",
    "intro",
    "tech",
    "dark",
    "minimal",
    "studio reel",
    "demo reel"
  ],
  "scenes": [
    {
      "duration": 72,
      "transition": {
        "type": "cut"
      },
      "layers": [
        {
          "motion": "kinetic-type-slam",
          "props": {
            "lines": [
              {
                "text": "Motion with intent",
                "accent": "intent"
              }
            ],
            "beatFrames": 9,
            "holdBeats": 2,
            "layout": "stack",
            "capHeight": 0.28,
            "background": "#0A0A0B",
            "ink": "#F5F5F4",
            "accent": "#FF5A1F",
            "flash": false,
            "showIndex": false,
            "push": 0.03
          }
        }
      ]
    },
    {
      "duration": 45,
      "transition": {
        "type": "cut"
      },
      "layers": [
        {
          "motion": "ui-shape-morph",
          "offset": 6,
          "props": {
            "states": [
              {
                "kind": "button",
                "label": "Get started",
                "width": 300,
                "height": 96,
                "radius": 48,
                "color": "#FF5A1F"
              },
              {
                "kind": "loader",
                "label": "",
                "width": 96,
                "height": 96,
                "radius": 48,
                "color": "#FF5A1F"
              },
              {
                "kind": "check",
                "label": "",
                "width": 96,
                "height": 96,
                "radius": 48,
                "color": "#2A2A2E"
              },
              {
                "kind": "player",
                "label": "Now playing",
                "width": 580,
                "height": 132,
                "radius": 38,
                "color": "#17171B"
              },
              {
                "kind": "chart",
                "label": "This week",
                "width": 520,
                "height": 320,
                "radius": 36,
                "color": "#17171B"
              },
              {
                "kind": "toast",
                "label": "Saved",
                "width": 420,
                "height": 112,
                "radius": 40,
                "color": "#FF5A1F"
              }
            ],
            "beatFrames": 8,
            "startFrame": 4,
            "background": "#0A0A0B",
            "ink": "#EDEBE7",
            "accent": "#FF5A1F",
            "cursor": true,
            "frameFill": 0.55
          }
        }
      ]
    },
    {
      "duration": 45,
      "transition": {
        "type": "cut"
      },
      "layers": [
        {
          "motion": "particle-shape-morph",
          "props": {
            "text": "MOVE",
            "shapes": [
              "glyph",
              "sphere",
              "torus"
            ],
            "holdFrames": 12,
            "morphFrames": 12,
            "collapse": false,
            "background": "#0A0A0B",
            "colors": [
              "#F5F5F4",
              "#FF5A1F",
              "#8A8A8E"
            ],
            "coreColor": "#FF5A1F",
            "label": "REEL",
            "hud": false,
            "count": 4200
          }
        }
      ]
    },
    {
      "duration": 45,
      "transition": {
        "type": "cut"
      },
      "layers": [
        {
          "motion": "line-draw-on",
          "props": {
            "background": "#0A0A0B",
            "grid": false,
            "strokeColor": "#F5F5F4",
            "highlightColor": "#FF5A1F",
            "drawFrames": 6,
            "stagger": 2,
            "startFrame": 2,
            "caption": "",
            "strokeWidth": 3
          }
        }
      ]
    },
    {
      "duration": 45,
      "transition": {
        "type": "cut"
      },
      "layers": [
        {
          "motion": "hex-island-grow",
          "offset": 40
        }
      ]
    },
    {
      "duration": 45,
      "transition": {
        "type": "cut"
      },
      "layers": [
        {
          "motion": "number-counter",
          "props": {
            "keyframes": [
              [
                0,
                0
              ],
              [
                4,
                0
              ],
              [
                40,
                1280
              ]
            ],
            "mode": "lock",
            "label": "SHOTS DELIVERED",
            "unit": "",
            "readouts": [],
            "backdrop": "ink",
            "numberColor": "#F5F5F4",
            "labelColor": "#8A8A8E",
            "accent": "#FF5A1F",
            "size": 300,
            "lockStart": 2,
            "lockStep": 4,
            "accentOnLock": true
          }
        }
      ]
    },
    {
      "duration": 150,
      "layers": [
        {
          "motion": "logo-assemble",
          "props": {
            "text": "Studio Nine",
            "tagline": "MOTION · DESIGN · CODE",
            "background": "#0A0A0B",
            "color": "#F5F5F4",
            "accent": "#FF5A1F",
            "fontRole": "sans",
            "weight": 600,
            "shardCount": 80
          }
        }
      ]
    }
  ],
  "overlays": [
    {
      "motion": "film-look",
      "from": 0,
      "duration": 447,
      "props": {
        "overlay": true,
        "grain": 0.05,
        "vignette": 0.25,
        "flare": false,
        "letterbox": "off",
        "bloom": 0,
        "fringe": 0
      }
    }
  ],
  "notes": "Hook word, logo text and tagline are placeholders: replace them, and pass your accent colour to every accent / colors / highlightColor prop. Each cut is 45 frames = 3 beats at 120 BPM (15 frames per beat); keep cuts on multiples of your beat and swap any cut for another contrasting motion (iso-bar-chart, number-counter, voxel-diorama, ocean-surface-3d, pointcloud-orbit). Use offset to skip a motion's slow intro. Audio: lay a track with cli/beats.py analysis and keep the cuts on its grid."
}