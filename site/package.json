{
  "name": "opus-motion-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Showcase website for the Opus Motion Library (GitHub Pages).",
  "scripts": {
    "assets": "node copy-assets.mjs",
    "dev": "npm run assets && vite",
    "build": "npm run assets && tsc --noEmit && vite build && node prerender/index.mjs && node scripts/verify-prerender.mjs",
    "preview": "vite preview --port 4174 --strictPort",
    "prerender": "node prerender/index.mjs",
    "og-card": "node scripts/make-og-card.mjs",
    "verify": "node scripts/verify-prerender.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.1.2",
    "@remotion/google-fonts": "4.0.532",
    "@remotion/layout-utils": "4.0.532",
    "@remotion/noise": "4.0.532",
    "@remotion/paths": "4.0.532",
    "@remotion/player": "4.0.532",
    "@remotion/three": "4.0.532",
    "@remotion/transitions": "4.0.532",
    "opus-motion-library": "file:..",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.532",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "^5.6.0",
    "vite": "6.4.5"
  }
}
